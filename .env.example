# Copy to .env and adjust. Never commit .env.

# Local development without Docker (default if unset):
DATABASE_URL=sqlite:///./gridpilot.db

# Local Postgres from docker compose (use this instead if the db container is running):
# DATABASE_URL=postgresql+psycopg://gridpilot:gridpilot@localhost:5432/gridpilot

# Used by docker-compose.yml. Change the password before deploying anywhere public.
POSTGRES_USER=gridpilot
POSTGRES_PASSWORD=gridpilot
POSTGRES_DB=gridpilot

BIDDING_ZONE=DE-LU
COUNTRY=de

# Weather forecasts (Phase 4): how many days before the valid time they were made
WEATHER_LEAD_DAYS=2

# Scheduler
# lgbm needs a trained model (python -m app.forecast.cli train); until then it falls back to profile_4w
FORECAST_MODEL=lgbm
MODEL_DIR=models
# Set this before putting the API on the internet; then POST/DELETE /jobs need  X-API-Key: <value>
API_KEY=

# Monitoring (Phase 5)
STALE_FEED_HOURS=3
FAILED_RUNS_ALERT=2
MODEL_MAX_AGE_DAYS=10
# Optional: a Discord or Slack incoming-webhook URL; incidents get posted there
ALERT_WEBHOOK_URL=
# Grafana admin password (dashboards are viewable without logging in)
GRAFANA_ADMIN_PASSWORD=change-me
