# Production settings for GridPilot. setup.sh copies this to .env and fills in
# random secrets. Never commit .env.

GRIDPILOT_DOMAIN=gridpilot.duckdns.org

POSTGRES_PASSWORD=
# Needed in the X-API-Key header for POST/DELETE /jobs. Reading stays public.
API_KEY=
GRAFANA_ADMIN_PASSWORD=

# Optional: a Discord or Slack incoming-webhook URL for incident alerts
ALERT_WEBHOOK_URL=
